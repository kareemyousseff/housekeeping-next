generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int            @id @default(autoincrement())
  email       String         @unique
  password    String
  name        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  memberships FamilyMember[] // all the families this user belongs to
}

model Family {
  id          String           @id @default(cuid())
  name        String

  memberships     FamilyMember[]    // all users in this family
  occupancyEvents OccupancyEvent[]
}

model FamilyMember {
  id          String    @id @default(cuid())
  userId      Int
  familyId    String
  joinedAt    DateTime  @default(now())

  // occupancy info, scoped to this user-in-this-family (current state)
  location    String?
  startedAt   DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  occupancyEvents OccupancyEvent[]

  @@unique([userId, familyId]) // no duplicate membership rows
}

// history: one row per stay in a room. current stay has endedAt = null
model OccupancyEvent {
  id        String    @id @default(cuid())
  memberId  String
  familyId  String
  room      String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, startedAt])
}

// to-do list for the worker. processedAt = null means not done yet
model Outbox {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt])
}
