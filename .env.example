# Copy this file to `.env` and fill in real values.
# Never commit `.env` — only this example belongs in git.

# Local `npm run dev` (Postgres on your machine)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/housekeeping

# Docker Compose db container (used on your laptop and on a server)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=housekeeping

NEXTAUTH_SECRET=generate-a-long-random-string
RESEND_API_KEY=
EMAIL_FROM=
